#!/bin/sh
set -eu
ROOT="${GIMP_MCP_ROOT:-$HOME/gimp-mcp}"
cd "$ROOT"
if ! /usr/bin/python3 -c "import PyQt6" >/dev/null 2>&1; then
  echo "PyQt6 fehlt. Installiere GUI-Abhaengigkeit via PolicyKit..." >&2
  if command -v pkexec >/dev/null 2>&1; then
    pkexec apt-get install -y python3-pyqt6
  else
    echo "Bitte installieren: sudo apt install python3-pyqt6" >&2
    exit 1
  fi
fi
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m gimp_mcp.gui "$@"
