#!/bin/sh
set -eu
ROOT="${GIMP_MCP_ROOT:-$HOME/gimp-mcp}"
cd "$ROOT"

# Prefer the project environment. This keeps GUI/MCP versions identical and
# avoids depending on whichever Python happens to be the distro default.
if [ -x "$ROOT/.venv/bin/python" ]; then
  exec "$ROOT/.venv/bin/python" -m gimp_mcp.gui "$@"
fi

UV="$(command -v uv 2>/dev/null || true)"
if [ -z "$UV" ] && [ -x "$HOME/.local/bin/uv" ]; then
  UV="$HOME/.local/bin/uv"
fi
if [ -n "$UV" ]; then
  "$UV" sync --group dev
  exec "$ROOT/.venv/bin/python" -m gimp_mcp.gui "$@"
fi

echo "GIMP MCP environment missing. Install uv, then run: uv sync --group dev" >&2
exit 1
